# RcppArmadillo and the portable formatting paths use modern C++.
CXX_STD = CXX17

GWLD_OPENMP_FLAGS = $(SHLIB_OPENMP_CXXFLAGS)
ifeq ($(GWLD_OPENMP),OFF)
GWLD_OPENMP_FLAGS =
PKG_CPPFLAGS += -DGWLD_NO_OPENMP -DARMA_DONT_USE_OPENMP
endif

PKG_CXXFLAGS = $(GWLD_OPENMP_FLAGS) -DARMA_64BIT_WORD=1
PKG_CPPFLAGS += $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript" --vanilla -e 'Rhtslib::pkgconfig("PKG_CPPFLAGS")')
ifeq ($(shell uname -s),Darwin)
# Expose Darwin's thread-safe lgamma_r used by the shared RMI kernel.
PKG_CPPFLAGS += -D_REENTRANT
endif
PKG_LIBS = $(GWLD_OPENMP_FLAGS) $(shell "${R_HOME}/bin${R_ARCH_BIN}/Rscript" --vanilla -e 'Rhtslib::pkgconfig("PKG_LIBS")') $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
